# Local defaults. Copy to .env only if you need overrides.
OLLAMA_HOST=http://127.0.0.1:11434
MODEL_NAME=qwen3.8:27b
REQUEST_TIMEOUT_SECONDS=120
KEEP_ALIVE=5m
THINK=false
NUM_CTX=4096
MAX_NEW_TOKENS=512
TEMPERATURE=0.0

# Local-only mode by default. Do not enable public sharing until the safety
# checks in docs/README_07_hadota_web_chat.md pass.
PUBLIC_MODE=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=

# Web resource safety defaults
MAX_REQUEST_BODY_BYTES=65536
MAX_MESSAGE_CHARS=4000
MAX_ACTIVE_SESSIONS=25
MAX_CONVERSATIONS_PER_SESSION=5
SESSION_IDLE_TTL_SECONDS=900
SESSION_ABSOLUTE_TTL_SECONDS=14400
SESSION_RATE_LIMIT_REQUESTS=10
SESSION_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_GENERATION_RATE_LIMIT_REQUESTS=20
GLOBAL_GENERATION_RATE_LIMIT_WINDOW_SECONDS=60
MAX_ACTIVE_GENERATIONS=1
